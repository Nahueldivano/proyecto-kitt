# =============================================================
# KITT — Variables de Entorno
# Copiá este archivo a .env y completá los valores
# =============================================================

# Base de datos PostgreSQL
DATABASE_URL="postgresql://user:password@host:5432/kitt"

# Auth (NextAuth v5)
AUTH_SECRET=""          # Generá con: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — OBLIGATORIO en .env (NextAuth los lee al arrancar el server)
# Configurar en: https://console.cloud.google.com
# Redirect URIs a agregar en Google Cloud Console:
#   http://localhost:3000/api/auth/callback/google  (dev)
#   http://localhost:3000/api/email/callback         (dev)
#   https://tudominio.com/api/auth/callback/google  (prod)
#   https://tudominio.com/api/email/callback         (prod)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- El resto se puede cargar desde Admin → Sistema (AppConfig en DB) ----

# Anthropic (Claude API)
ANTHROPIC_API_KEY=""

# Evolution API (WhatsApp)
EVOLUTION_API_URL=""    # Ej: http://tu-servidor:8080
EVOLUTION_API_KEY=""

# OpenAI (Whisper para transcripción de audios de WhatsApp)
OPENAI_API_KEY=""

# KITT internal (compartida con n8n para rutas /api/internal/*)
KITT_INTERNAL_KEY=""    # Generá con: openssl rand -hex 32

# Admin (el único email que puede acceder a /admin)
KITT_ADMIN_EMAIL=""     # Ej: nahuel@smartgrowth.com
