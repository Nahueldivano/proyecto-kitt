# ─── Base de datos ───────────────────────────────────────────────────────────
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://kitt:TU_PASSWORD@postgres:5432/kitt
POSTGRES_PASSWORD=TU_PASSWORD_SEGURA

# ─── Auth ────────────────────────────────────────────────────────────────────
AUTH_SECRET=GENERALO_CON_openssl_rand_-base64_64
NEXTAUTH_URL=https://tudominio.com

# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Google OAuth (Gmail) ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── WhatsApp (Evolution API) ────────────────────────────────────────────────
EVOLUTION_API_URL=https://evolution.tudominio.com
EVOLUTION_API_KEY=

# ─── Redis (memoria entre conversaciones) ────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Seguridad interna ───────────────────────────────────────────────────────
KITT_INTERNAL_KEY=GENERALO_CON_openssl_rand_-hex_32
KITT_ADMIN_EMAIL=tu@email.com

# ─── Encriptación (tokens OAuth y API keys en DB) ────────────────────────────
# OBLIGATORIO — generá con: openssl rand -hex 32
ENCRYPTION_KEY=GENERALO_CON_openssl_rand_-hex_32

# ─── Cron sync (POST /api/cron/sync) ─────────────────────────────────────────
CRON_SECRET=GENERALO_CON_openssl_rand_-hex_32

# ─── n8n (opcional) ──────────────────────────────────────────────────────────
N8N_WEBHOOK_URL=
