// =============================================================
// KITT — Prisma Schema — PRODUCCIÓN (PostgreSQL)
// Este archivo se usa durante el build de Docker.
// Para desarrollo local, usar schema.prisma (SQLite).
// =============================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================
// MULTI-TENANT
// =============================================================

model Tenant {
  id             String           @id @default(cuid())
  name           String
  config         String           @default("{}")
  createdAt      DateTime         @default(now())

  users          User[]
  whatsappSession WhatsappSession?
  gmailConnection GmailConnection?
  conversations  Conversation[]
  folders        Folder[]
  reports        Report[]
  pendingActions PendingAction[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String?
  name           String?
  tenantId       String
  onboardingDone Boolean  @default(false)
  createdAt      DateTime @default(now())

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// =============================================================
// INTEGRACIONES
// =============================================================

model WhatsappSession {
  id           String    @id @default(cuid())
  tenantId     String    @unique
  status       String    @default("disconnected")
  instanceName String
  connectedAt  DateTime?

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model GmailConnection {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  email        String
  accessToken  String
  refreshToken String
  connectedAt  DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// =============================================================
// CONVERSACIONES Y MENSAJES
// =============================================================

model Folder {
  id            String         @id @default(cuid())
  tenantId      String
  name          String
  color         String?
  position      Int            @default(0)
  createdAt     DateTime       @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([tenantId])
}

model Conversation {
  id        String    @id @default(cuid())
  tenantId  String
  folderId  String?
  title     String?
  createdAt DateTime  @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folder    Folder?   @relation(fields: [folderId], references: [id])
  messages  Message[]

  @@index([tenantId])
  @@index([folderId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  type           String       @default("text")
  metadata       String       @default("{}")
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// =============================================================
// REPORTES AUTOMÁTICOS
// =============================================================

model Report {
  id          String   @id @default(cuid())
  tenantId    String
  type        String
  content     String
  generatedAt DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, generatedAt])
}

// =============================================================
// ACCIONES PENDIENTES (aprobación humana obligatoria)
// =============================================================

model PendingAction {
  id        String   @id @default(cuid())
  tenantId  String
  type      String
  payload   String   @default("{}")
  status    String   @default("pending")
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

// =============================================================
// CONFIGURACIÓN GLOBAL (admin UI → runtime)
// =============================================================

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// =============================================================
// WHATSAPP MESSAGES (almacenamiento local para búsqueda)
// =============================================================

model WhatsappMessage {
  id          String   @id @default(cuid())
  tenantId    String
  remoteJid   String
  fromMe      Boolean  @default(false)
  content     String
  messageType String   @default("text")
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
}
