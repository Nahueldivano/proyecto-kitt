// =============================================================
// KITT — Prisma Schema
// PostgreSQL + Prisma v6 con driver adapter (pg)
// =============================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================
// MULTI-TENANT
// =============================================================

model Tenant {
  id             String           @id @default(cuid())
  name           String
  config         Json             @default("{}")
  createdAt      DateTime         @default(now())

  users          User[]
  whatsappSession WhatsappSession?
  gmailConnection GmailConnection?
  conversations  Conversation[]
  folders        Folder[]
  reports        Report[]
  pendingActions PendingAction[]
  contacts       Contact[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String?
  name           String?
  tenantId       String
  onboardingDone Boolean  @default(false)
  createdAt      DateTime @default(now())

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// =============================================================
// INTEGRACIONES
// =============================================================

model WhatsappSession {
  id           String    @id @default(cuid())
  tenantId     String    @unique
  status       String    @default("disconnected") // disconnected | connecting | connected
  instanceName String
  connectedAt  DateTime?

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model WhatsappMessage {
  id           String   @id @default(cuid())
  tenantId     String
  externalId   String?  // ID del mensaje en Evolution API (key.id)
  chatJid      String   // JID del contacto/grupo (ej: 5491157589161@s.whatsapp.net)
  contactName  String?  // nombre del contacto (agenda o pushName)
  chatName     String?  // nombre del grupo (para @g.us)
  fromMe       Boolean  @default(false)
  body         String   @db.Text
  messageType  String   @default("text") // text | image | audio | video | document | sticker | other
  timestamp    DateTime
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  @@unique([tenantId, externalId])
  @@index([tenantId, chatJid, timestamp])
  @@index([tenantId, timestamp])
}

model GmailConnection {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  email        String
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  connectedAt  DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// =============================================================
// CONVERSACIONES Y MENSAJES
// =============================================================

model Folder {
  id        String         @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime       @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([tenantId])
}

model Conversation {
  id        String    @id @default(cuid())
  tenantId  String
  title     String?
  folderId  String?
  model     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folder    Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  messages  Message[]

  @@index([tenantId])
  @@index([folderId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String       // user | assistant | tool
  content        String       @db.Text
  type           String       @default("text") // text | artifact
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// =============================================================
// REPORTES AUTOMÁTICOS
// =============================================================

model Report {
  id          String   @id @default(cuid())
  tenantId    String
  type        String   // morning | midday | evening
  content     String   @db.Text
  generatedAt DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, generatedAt])
}

// =============================================================
// ACCIONES PENDIENTES (aprobación humana obligatoria)
// =============================================================

model PendingAction {
  id           String    @id @default(cuid())
  tenantId     String
  type         String    // send_email | reply_email | send_whatsapp_message
  payload      Json
  status       String    @default("pending") // pending | approved | rejected | failed
  errorMessage String?
  executedAt   DateTime?
  createdAt    DateTime  @default(now())

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

// =============================================================
// CONTACTOS (fuente de verdad para nombres y JIDs de WA)
// =============================================================

model Contact {
  id          String   @id @default(cuid())
  tenantId    String
  chatJid     String   // JID canónico: número@s.whatsapp.net o grupo@g.us
  name        String   // Nombre asignado por el usuario
  phone       String?  // Número puro sin @suffix (para búsqueda)
  isGroup     Boolean  @default(false)
  isFavorite  Boolean  @default(false)
  notes       String?
  tags        String[]
  syncEnabled Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, chatJid])
  @@index([tenantId])
  @@index([tenantId, syncEnabled])
  @@index([tenantId, isFavorite])
}

// =============================================================
// CONFIGURACIÓN GLOBAL (admin UI → runtime)
// =============================================================

model AppConfig {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
